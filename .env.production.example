# ==============================================
# Contract AI System — Production Environment
# ==============================================
# Copy to .env and fill in real values

# --- Application ---
APP_ENV=production
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET

# --- PostgreSQL ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://contract_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/contract_ai

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- LLM Providers ---
DEFAULT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
LLM_QUICK_MODEL=deepseek-v4-flash
LLM_DEEP_MODEL=deepseek-v4-pro
ROUTER_DEFAULT_MODEL=deepseek-v4-flash
ROUTER_COMPLEXITY_THRESHOLD=0.8
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
QWEN_API_KEY=

# --- Frontend ---
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/api/v1/ws
